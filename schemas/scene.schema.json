{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "npcs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "const": "opening-station"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "npcs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "character",
          "dialogue",
          "position",
          "facing",
          "movement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "character": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "dialogue": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^[\\x20-\\x7e\\n]*$"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 400,
                "maximum": 592,
                "multipleOf": 8
              },
              "y": {
                "type": "integer",
                "minimum": 248,
                "maximum": 320,
                "multipleOf": 8
              }
            }
          },
          "facing": {
            "enum": [
              "north",
              "east",
              "south",
              "west"
            ]
          },
          "movement": {
            "type": "object",
            "required": [
              "mode",
              "waypoints"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "stationary",
                  "patrol"
                ]
              },
              "waypoints": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 592,
                      "multipleOf": 8
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 248,
                      "maximum": 320,
                      "multipleOf": 8
                    },
                    "pause": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 120,
                      "default": 30
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "patrol"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "waypoints": {
                      "minItems": 2
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "title": "Evermore opening scene"
}
