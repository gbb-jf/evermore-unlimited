{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "palette",
    "animations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {
          "const": "transparent"
        }
      ],
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "animations": {
      "type": "object",
      "required": [
        "idle",
        "walk"
      ],
      "properties": {
        "idle": {
          "type": "object",
          "required": [
            "north",
            "east",
            "south",
            "west"
          ],
          "properties": {
            "north": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            },
            "east": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            },
            "south": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            },
            "west": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            }
          }
        },
        "walk": {
          "type": "object",
          "required": [
            "north",
            "east",
            "south",
            "west"
          ],
          "properties": {
            "north": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            },
            "east": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            },
            "south": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            },
            "west": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/frame"
              }
            }
          }
        }
      }
    }
  },
  "title": "Evermore character",
  "$defs": {
    "frame": {
      "type": "object",
      "required": [
        "duration",
        "pixels"
      ],
      "properties": {
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "pixels": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[.1-9a-f]{32}$"
          }
        }
      }
    }
  }
}
